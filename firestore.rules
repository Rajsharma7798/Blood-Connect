rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection Rules
    match /Users/{userId} {
      // Anyone can read a user profile (needed for matching logic)
      allow read: if true;
      // Users can only create or update their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // No one can delete profiles except admnins (not implemented yet)
      allow delete: if false;
    }

    // Hospitals Collection Rules
    match /Hospitals/{hospitalId} {
      // Anyone can view hospital data
      allow read: if true;
      // Only authenticated hospital accounts can modify
      allow write: if request.auth != null && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'recipient';
    }

    // BloodRequests Collection Rules
    match /BloodRequests/{requestId} {
      // Anyone can view active requests
      allow read: if true;
      // Authenticated users can create requests
      allow create: if request.auth != null;
      // Only the creator or an admin can update/delete
      allow update, delete: if request.auth != null;
    }
  }
}
